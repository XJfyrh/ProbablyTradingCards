<Project>
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(PROBABLY_STOLEN_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and '$(MSBuildProgramFiles32)' != ''">$(MSBuildProgramFiles32)/Steam/steamapps/common/Probably Stolen</GameDir>
  </PropertyGroup>
  <Target Name="CheckGameDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == '' or !Exists('$(GameDir)/Probably Stolen_Data/Managed')"
           Text="找不到游戏程序集。请用 -p:GameDir 指定 Probably Stolen 安装目录，或设置 PROBABLY_STOLEN_GAME_DIR。" />
  </Target>
</Project>
